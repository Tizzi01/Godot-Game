script/source = "extends CharacterBody2D
class_name Player
signal player_damaged
@onready var dash_sfx = $DashSFX
@onready var dash_particles: CPUParticles2D = $DashParticles

var is_hidden_from_mobs := false
@export var walk_speed = 150.0
@export var run_speed = 250.0
@export_range(0,1) var acceleration = 0.1
@export_range(0,1) var decceleration = 0.1
var has_space_shift := false
var health = 100.0
var tp_unlocked := false
@onready var tp_anim_player: AnimationPlayer = $PlayerSprite/HitFlash
#borders
var pushback_timer = 0.0
var frozen := false
@export var jump_force = -300.0
@export_range(0,1) var deccelerate_on_jump_release = 0.5
@onready var gun_node = $Gun
# slash
@onready var anim_player: AnimationPlayer = $PlayerSprite/AnimationPlayer
@onready var hitbox: Area2D = %Gun
@onready var slash_anim: AnimationPlayer = gun_node.get_node(\"AnimationPlayer\")
var kill_count := 0
var tp_ready := true
# dashing
@export var dash_speed = 950.0
@export var dash_max_distance = 100.0
@export var dash_curve : Curve
@export var dash_cooldown = 1.0

@export var Gun_radius: float = 20.0
@export var Gun_follow_speed: float = 10.0
@onready var black_hole_cooldown_timer: Timer = $BlackHoleCooldownTimer
@onready var black_hole_cooldown_bar: ProgressBar = get_node(\"/root/Game/CanvasLayer3/BHCD\")
var black_hole_ready := true
var black_hole_tween: Tween = null
var black_hole_unlocked := false
var current_weapon: Node = null
var weapon_index := 0
var weapon_scenes := [preload(\"res://Folder/Scenes/gun.tscn\"),preload(\"res://Folder/Scenes/gun2.tscn\") ]


var is_dashing = false
var dash_start_position = Vector2.ZERO
var dash_direction = Vector2.ZERO
var dash_timer = 0.0
@onready var omni: AudioStreamPlayer = $Omni

var was_on_floor = true
var is_jumping = false
@export var max_jumps = 99
var jump_count = 0
@onready var tp_bar := get_node(\"/root/Game/CanvasLayer/TeleportCooldownBar\")
@onready var sprite: Sprite2D = $PlayerSprite
signal teleport_cooldown_started(duration: float)
# teleport hover
var teleporting = false
var teleport_hovering = false
var teleport_hover_timer = 0.0
var teleport_hover_max_time = 2.0
var last_facing_dir = 1
signal teleport_unlocked
# damage
signal health_depleted

func _ready(): 
	
	black_hole_cooldown_timer.timeout.connect(_on_black_hole_cooldown_timer_timeout)
	black_hole_cooldown_bar.visible = false
	_spawn_weapon(0)
	
	add_to_group(\"player\")
	for mob in get_tree().get_nodes_in_group(\"Mob\"):
		mob.died.connect(_on_mob_died)

	for mob2 in get_tree().get_nodes_in_group(\"Mob2\"):
		mob2.died.connect(_on_mob2_died)
	
	anim_player.play(\"Idle\")

	var game_node = get_tree().get_root().get_node(\"Game\")
	if game_node:
		game_node.game_over_triggered.connect(_on_game_over_triggered) 
		
		
		
func take_damage(amount: float) -> void:
	if frozen:
		return

	health -= amount
	player_damaged.emit()
	anim_player.play(\"Damage\")
	omni.play()  # Plays your damage sound

	for bar in get_tree().get_nodes_in_group(\"HPBAR\"):
		bar.value = health

	if health <= 0.0:
		health_depleted.emit()

# gun tracking
var Gun_mouse_pos: Vector2 = Vector2.ZERO

func _physics_process(delta):
	
	if Input.is_action_just_pressed(\"shockwave\"):
		_spawn_shockwave()
	
	if frozen:
		return
	
	const DAMAGE_RATE = 5.0 
	var overlapping_mobs = %HurtBox.get_overlapping_bodies()
	if overlapping_mobs.size() > 0: 
		health -= DAMAGE_RATE * overlapping_mobs.size() * delta 
		anim_player.play(\"Damage\")
		player_damaged.emit()
		for bar in get_tree().get_nodes_in_group(\"HPBAR\"):
			bar.value = health

		if health <= 0.0: 
			health_depleted.emit() 
			
	# Hover freeze
	if teleport_hovering:
		velocity = Vector2.ZERO
		teleport_hover_timer += delta
		$PlayerSprite/AnimationPlayer.play(\"Idle\")

		if teleport_hover_timer >= teleport_hover_max_time or Input.is_action_just_pressed(\"jump\") or Input.is_action_just_pressed(\"dash\") or Input.is_action_pressed(\"left\") or Input.is_action_pressed(\"right\"):
			teleport_hovering = false
			teleporting = false
			teleport_hover_timer = 0.0

	var speed = walk_speed
	if Input.is_action_pressed(\"run\"):
		speed = run_speed

	var input_vector = Vector2(
		Input.get_action_strength(\"right\") - Input.get_action_strength(\"left\"),
		Input.get_action_strength(\"down\") - Input.get_action_strength(\"up\")
	).normalized()

	if input_vector.x != 0:
		last_facing_dir = sign(input_vector.x)

	velocity.x = move_toward(velocity.x, input_vector.x * speed, speed * acceleration)
	velocity.y = move_toward(velocity.y, input_vector.y * speed, speed * acceleration)

	if Input.is_action_just_pressed(\"jump\"):
		if is_on_floor():
			velocity.y = jump_force
			jump_count = 1
		elif jump_count < max_jumps:
			velocity.y = jump_force
			jump_count += 1

		if teleporting:
			teleport_hovering = false
			teleporting = false
			teleport_hover_timer = 0.0

	if is_on_floor():
		jump_count = 0

	sprite.flip_h = last_facing_dir < 0
	# Flip dash particle gravity based on facing direction
	# Make dash particles follow full movement direction
	var gravity_direction = -velocity.normalized() * 50000.0
	dash_particles.gravity = gravity_direction

	if Input.is_action_just_pressed(\"dash\") and not is_dashing and dash_timer <= 0:
		if input_vector.length() > 0.1:
			is_dashing = true 		
			dash_start_position = global_position
			dash_direction = input_vector
			dash_timer = dash_cooldown
			dash_sfx.play_with_variation()
			dash_particles.emitting = true
			if teleporting:
				teleport_hovering = false
				teleporting = false
				teleport_hover_timer = 0.0

	if is_dashing:
		if dash_direction.length() < 0.1:
			is_dashing = false
		else:
			var current_distance = global_position.distance_to(dash_start_position)
			if current_distance >= dash_max_distance or is_on_wall():
				is_dashing = false
			else:
				velocity = dash_direction * dash_speed * dash_curve.sample(current_distance / dash_max_distance)

	if dash_timer > 0:
		dash_timer -= delta



	if Input.is_action_just_pressed(\"tp\"):
		if not tp_unlocked:
			print(\"❌ TP blocked — signal not received\")
			return 
			
		if not tp_ready:
			print(\"⏳ TP on cooldown\")
			return

	# ✅ teleport logic...
		var target_pos = get_global_mouse_position()
		var space_state = get_world_2d().direct_space_state
		var shape = $CollisionShape2D.shape.duplicate()

		var query = PhysicsShapeQueryParameters2D.new()
		query.shape = shape
		query.transform = Transform2D.IDENTITY.translated(target_pos)
		query.collide_with_areas = true
		query.collide_with_bodies = true

		var result = space_state.intersect_shape(query)

		if result.is_empty():
			tp_ready = false
			emit_signal(\"teleport_cooldown_started\", $TeleportCooldownTimer.wait_time)
			$TeleportCooldownTimer.start()
			global_position = target_pos
			$Camera2D.add_vertical_trauma(0.3)

			teleporting = true
			teleport_hovering = true
			teleport_hover_timer = 0.0
			velocity = Vector2.ZERO
			$PlayerSprite/AnimationPlayer.play(\"Idle\")
			$TP1.play()
			tp_anim_player.play(\"TP\")  
			

			
			is_hidden_from_mobs = true
			await get_tree().create_timer(0.4).timeout
			is_hidden_from_mobs = false
			
		else:
			var collision = result[0]
			if collision.has(\"normal\"):
				var push_dir = collision[\"normal\"].normalized()
				var safe_pos = target_pos + push_dir * 10.0
				query.transform = Transform2D.IDENTITY.translated(safe_pos)
				var recheck = space_state.intersect_shape(query)

				if recheck.is_empty():
					tp_ready = false
					emit_signal(\"teleport_cooldown_started\", $TeleportCooldownTimer.wait_time)
					$TeleportCooldownTimer.start()
					
					global_position = safe_pos
					$Camera2D.add_trauma(0.4)

					teleporting = true
					teleport_hovering = true
					teleport_hover_timer = 0.0
					velocity = Vector2.ZERO
					$PlayerSprite/AnimationPlayer.play(\"Idle\")
					$TP1.play()
					tp_anim_player.play(\"TP\") 
					
			
					
					is_hidden_from_mobs = true
					await get_tree().create_timer(0.2).timeout
					is_hidden_from_mobs = false
					
				else:
					print(\"Blocked! Can't teleport too close to wall.\")
			else:
				print(\"Collision has no normal — skipping safe push.\")

	if velocity == Vector2.ZERO and not teleporting and not is_dashing:
		if Input.is_action_pressed(\"left\") or Input.is_action_pressed(\"right\") or Input.is_action_pressed(\"up\") or Input.is_action_pressed(\"down\"):
			velocity = input_vector * walk_speed
			print(\"✅ Unstuck player with input\")

	if is_on_floor() and velocity.x == 0:
		$PlayerSprite/AnimationPlayer.play(\"Idle\") 
		
	move_and_slide() 
	
	if get_slide_collision_count() > 0:
		for i in get_slide_collision_count():
			var col = get_slide_collision(i)
			var collider = col.get_collider()
			if collider and collider.is_in_group(\"Borders\"):
				print(\"got touched\")

				var push_dir = col.get_normal().normalized()
				velocity = push_dir * (800 * 0.85)
				pushback_timer = 0.4

func _on_tp_signal_received():
	tp_unlocked = true
	print(\"📡 TP signal received — teleport unlocked\")
	emit_signal(\"teleport_unlocked\")
	
func _on_black_hole_signal_received():
	black_hole_unlocked = true
	print(\"🌀 Black hole unlocked — ready to use\")
	black_hole_cooldown_bar.visible = true

func _input(event: InputEvent) -> void:
	if event is InputEventMouseButton and event.pressed:
		var next_index := weapon_index

		if event.button_index == MOUSE_BUTTON_WHEEL_UP:
			next_index = (weapon_index + 1) % weapon_scenes.size()

		elif event.button_index == MOUSE_BUTTON_WHEEL_DOWN:
			next_index = (weapon_index - 1 + weapon_scenes.size()) % weapon_scenes.size()

		# 🛑 Block Gun2 if not unlocked
		if next_index == 1 and not black_hole_unlocked:
			print(\"❌ Gun2 blocked — black hole not purchased\")
			return

		# ✅ Play animation only if weapon is allowed
		if next_index != weapon_index:
			if current_weapon and current_weapon.has_method(\"play_change_animation\"):
				current_weapon.play_change_animation()
				await get_tree().create_timer(0.2).timeout

		weapon_index = next_index
		_spawn_weapon(weapon_index)
		if get_viewport().gui_get_focus_owner() and get_viewport().gui_get_focus_owner().is_in_group(\"shop_ui\"):
			return
	if frozen:
		return

	if current_weapon and event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and event.pressed:
		var anim = current_weapon.get_node_or_null(\"AnimationPlayer\")
		if anim and not anim.is_playing():
			anim.play(\"slash\")

		if teleporting:
			teleport_hovering = false
			teleporting = false
			teleport_hover_timer = 0.0
	
	if frozen:
		return

	if current_weapon and event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and event.pressed:
		var anim = current_weapon.get_node_or_null(\"AnimationPlayer\")
		if anim and not anim.is_playing():
			anim.play(\"slash\")

		if teleporting:
			teleport_hovering = false
			teleporting = false
			teleport_hover_timer = 0.0 
			
func _on_mob_died():
	kill_count += 1
	PointsManager.add_points(1)
	print(\"+1\")

func _on_mob2_died():
	kill_count += 5
	PointsManager.add_points(5)
	print(\"+5\")

func _on_game_over_triggered():
	frozen = true
	print(\"🧊 Player frozen — input disabled\")


func _on_teleport_cooldown_timer_timeout() -> void:
	tp_ready = true
	print(\"✅ TP cooldown finished\") 
	



func _spawn_weapon(index: int):
	# 🧹 Clean up old weapon if it's not the default gun
	if current_weapon and current_weapon != gun_node:
		current_weapon.is_active = false  # ✅ Turn off old gun
		current_weapon.queue_free()       # ✅ Delete old gun
		current_weapon = null

	# 🔫 If index is 1, spawn gun2 (black hole gun)
	if index == 1:
		if not black_hole_unlocked:
			print(\"❌ Gun2 blocked — black hole not purchased\")
			return

		gun_node.visible = false
		gun_node.can_fire = false

		current_weapon = weapon_scenes[1].instantiate()
		add_child(current_weapon)
		current_weapon.position = gun_node.position
		current_weapon.is_active = true  # ✅ Turn on gun2

	# 🔫 If index is 0, use default gun
	else:
		gun_node.visible = true
		gun_node.can_fire = true
		current_weapon = gun_node
		current_weapon.is_active = true  # ✅ Turn on gun1


func can_spawn_black_hole() -> bool:
	return black_hole_ready

func start_black_hole_cooldown():
	black_hole_ready = false
	black_hole_cooldown_timer.start()
	start_black_hole_cooldown_bar()

func _on_black_hole_cooldown_timer_timeout():
	black_hole_ready = true
	reset_black_hole_cooldown_bar()
	print(\"✅ Black hole cooldown finished\")

func start_black_hole_cooldown_bar():
	black_hole_cooldown_bar.visible = true
	black_hole_cooldown_bar.max_value = 100
	black_hole_cooldown_bar.value = 100

	if black_hole_tween:
		black_hole_tween.kill()

	black_hole_tween = create_tween()
	black_hole_tween.tween_property(black_hole_cooldown_bar, \"value\", 0, black_hole_cooldown_timer.wait_time) \\
		.set_trans(Tween.TRANS_CUBIC) \\
		.set_ease(Tween.EASE_IN)

func reset_black_hole_cooldown_bar():
	if black_hole_tween:
		black_hole_tween.kill()
		black_hole_tween = null

	black_hole_cooldown_bar.value = 0
	black_hole_cooldown_bar.visible = true


func _spawn_shockwave():
	var shockwave_scene = preload(\"res://Demo/Scenes/shockwave.tscn\")
	var shockwave = shockwave_scene.instantiate()
	add_child(shockwave)  # ✅ Attach shockwave to player
	shockwave.position = Vector2.ZERO  # ✅ Place it at player's center
	$Omni.play() 
"

